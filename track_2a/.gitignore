# External data and generated files remain local; never delete them for packaging.
/repos/
/data/*
!/data/README.md
!/data/request.json
!/data/examples/
!/data/example_claims.json
# Scratch probes are retained locally; existing tracked probes are preserved explicitly.
/tmp/*
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
.env
.env.*
!.env.example
