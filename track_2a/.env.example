# Submission application. Required: provisioned vLLM-compatible v1.5 endpoint.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=
LLM_API_KEY=
# Match the actual server context limit, including the 512-token output reserve.
LLM_CONTEXT_TOKENS=32768
# required (default) = endpoint implements /tokenize. optional = endpoint without
# it (e.g. mlx_lm.server); only for a local development endpoint, see RUNNING.md.
LLM_TOKEN_PREFLIGHT=required
REQUEST_FILE=/app/data/request.json
