# Default judge path: an externally provisioned Apertus v1.5 endpoint.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
LLM_CONTEXT_TOKENS=32768
# External endpoints need not implement /tokenize. Completion usage and
# finish_reason remain mandatory. Set required only when /tokenize is available.
LLM_TOKEN_PREFLIGHT=optional

# For managed 8B also set LLM_NAME=swiss-ai/Apertus-v1.5-8B.
# Optional managed deployment (`make run SUBMISSION_MODE=managed`): NVIDIA GPU,
# Container Toolkit and gated-model access are required. Never commit this token.
HF_TOKEN=
# Published mutable tag; a tested image digest can be supplied here later.
APERTUS_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest-amd64
APERTUS_PLATFORM=linux/amd64
REQUEST_FILE=/app/data/request.json

# Optional new result file inside the mounted data directory; never overwritten.
RESULT_FILE=
