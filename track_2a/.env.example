# Managed Docker deployment: NVIDIA GPU + Container Toolkit required.
# Accept the official model's access conditions on Hugging Face, then supply
# a read token with access. Needed for a fresh download; never commit .env.
HF_TOKEN=
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# Managed mode uses this internal service. For a provisioned external endpoint,
# change this URL and run: make run SUBMISSION_MODE=external
LLM_BASE_URL=http://apertus:8000
# Optional API authentication shared by the managed server and application.
LLM_API_KEY=
# Shared server/application context limit, including the 512-token output reserve.
LLM_CONTEXT_TOKENS=32768
# Published mutable tag; a tested image digest can be supplied here later.
APERTUS_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest-amd64
APERTUS_PLATFORM=linux/amd64
REQUEST_FILE=/app/data/request.json

# Optional new result file inside the mounted data directory; never overwritten.
RESULT_FILE=
