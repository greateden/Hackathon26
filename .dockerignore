# Keep the build context small and reproducible: only src/ +
# requirements.txt are COPYed into the image; everything else is either
# mounted at run time (data/, repos/) or irrelevant to the build.
.git
.gitignore
.venv
venv
repos
data
Dockerfile
compose.yaml
Makefile
README.md
AGENTS.md
REPORT_HACKAPERTUS_OST.md
run.sh
**/__pycache__
**/*.py[cod]
.DS_Store
